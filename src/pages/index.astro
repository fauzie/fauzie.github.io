---
import { getCollection } from "astro:content";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Projects from "../components/Projects.astro";
import Services from "../components/Services.astro";
import Skills from "../components/Skills.astro";
import "../styles/global.css";

const skills = await getCollection("skills");
const experiences = await getCollection("experiences");
const projects = await getCollection("projects");
const services = await getCollection("services");
const siteUrl = "https://fauzie.id";
const pageTitle = "FAUZIE — Full-Stack Developer";
const pageDescription =
    "Fauzie is a freelance full-stack developer building fast, reliable digital products.";
const socialImage = `${siteUrl}/img/cover.webp`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={pageDescription} />
        <meta name="author" content="fauzie" />
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <meta name="theme-color" content="#00050c" />
        <link rel="canonical" href={siteUrl} />
        <title>{pageTitle}</title>

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="FAUZIE" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:url" content={siteUrl} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content={pageTitle} />
        <meta property="og:image:type" content="image/webp" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={pageTitle} />

        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                name: "Rizal Fauzie Ridwan",
                url: siteUrl,
                jobTitle: "Freelance Full-Stack Developer",
                description: pageDescription,
                image: socialImage,
            })}
        />
        <link
            rel="icon"
            type="image/png"
            href="/img/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/img/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin="anonymous"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Inconsolata:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="halo"></div>
        <Nav />
        <Hero />
        <Skills items={skills} />
        <Experience items={experiences} />
        <Projects items={projects} />
        <Services items={services} />
        <Contact />
        <Footer />
    </body>
</html>
